+def expected_seal(api, specs):
+    return {"t": "ict.dmf.sealed/v1", "document_id": DOCUMENT_ID, "dependency": api.dependency,
+            "sources": source_entries(specs), "policy_sha256": api.content_sha256(json_bytes(POLICY))}
